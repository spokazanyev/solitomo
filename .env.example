DATABASE_URI=postgres://soliton:soliton_dev_password@localhost:5432/soliton
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_YANDEX_METRICA_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Cart and Checkout (spec 037)
# ЮKassa: получите shop ID и secret key в личном кабинете https://yookassa.ru/my
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=true
# Webhook ЮKassa отключён по умолчанию до выдачи продакшен-ключей
YOOKASSA_MOCK_DISABLED=true

# SMTP для отправки счетов и нотификаций заказов
ORDER_NOTIFICATIONS_FROM=
ORDER_NOTIFICATIONS_MANAGER=
