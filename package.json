{
  "name": "soliton-organic-site",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @soliton/web dev",
    "build": "pnpm --filter @soliton/web build",
    "lint": "pnpm --filter @soliton/web lint",
    "typecheck": "pnpm --filter @soliton/web typecheck",
    "agent:context": "pnpm --filter @soliton/web agent:context",
    "seed:catalog": "pnpm --filter @soliton/web seed:catalog",
    "seed:catalog:dry-run": "pnpm --filter @soliton/web seed:catalog:dry-run",
    "public-copy-audit": "pnpm --filter @soliton/web public-copy-audit",
    "validate:seo": "pnpm --filter @soliton/web validate:seo",
    "validate:schema": "pnpm --filter @soliton/web validate:schema"
  }
}
