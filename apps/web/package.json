{
  "name": "@soliton/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "agent:context": "node scripts/agent-context.mjs",
    "agent:propose-change": "node scripts/agent-operation-placeholder.mjs agent:propose-change",
    "agent:apply-change": "node scripts/agent-operation-placeholder.mjs agent:apply-change",
    "export:catalog": "node scripts/agent-operation-placeholder.mjs export:catalog",
    "seed:catalog": "payload seed:catalog",
    "seed:catalog:dry-run": "pnpm exec payload seed:catalog --dry-run",
    "seed:static-pages": "payload seed:static-pages",
    "seed:analytics-settings": "payload seed:analytics-settings",
    "seed:soliton-certs": "payload seed:soliton-certs",
    "validate:catalog": "node scripts/agent-operation-placeholder.mjs validate:catalog",
    "validate:seo": "node scripts/validate-seo.mjs",
    "validate:schema": "node scripts/validate-schema.mjs",
    "smoke:public-pages": "node scripts/agent-operation-placeholder.mjs smoke:public-pages",
    "public-copy-audit": "node scripts/public-copy-audit.mjs",
    "download:legacy-assets": "node scripts/download-legacy-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "metrika:apply-config": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/metrika-apply-config.ts",
    "metrika:validate-config": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/metrika-validate-config.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/translations": "^3.84.1",
    "@payloadcms/ui": "^3.84.1",
    "axios": "^1.13.2",
    "axios-rate-limit": "^1.4.0",
    "axios-retry": "^4.5.0",
    "graphql-request": "^7.1.0",
    "libphonenumber-js": "^1.13.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "payload": "^3.84.1",
    "pdfkit": "^0.18.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.0"
  }
}
